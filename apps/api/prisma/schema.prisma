generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  ADMIN
  OPERATOR
}

enum CustomerStatus {
  ENABLED
  DISABLED
}

enum OrderStatus {
  PENDING_PAYMENT
  PENDING_PICKUP
  COMPLETED
  CANCELLED
  REFUNDING
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CLOSED
  REFUNDED
}

enum AssetStorage {
  LOCAL
  MINIO
  COS
  OSS
}

enum BannerScene {
  HOME_TOP
  HOME_PROMOTION
}

enum PromotionType {
  SECKILL
  RECOMMEND
}

enum CouponType {
  FULL_REDUCTION
}

enum CustomerCouponStatus {
  AVAILABLE
  USED
  EXPIRED
}

enum AfterSaleType {
  REFUND_ONLY
  RETURN_REFUND
}

enum AfterSaleStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
  CANCELLED
}

enum NotificationType {
  ORDER
  PAYMENT
  AFTER_SALE
  SYSTEM
}

enum PointsChangeType {
  ORDER_REWARD
  REFUND_DEDUCT
  MANUAL_ADJUST
}

model AdminUser {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(OPERATOR)
  enabled      Boolean   @default(true)
  operationLogs AdminOperationLog[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model AdminOperationLog {
  id          String    @id @default(cuid())
  adminUserId String?
  module      String
  action      String
  resourceId  String?
  summary     String
  beforeData  Json?
  afterData   Json?
  ip          String?
  userAgent   String?
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id])
  createdAt   DateTime  @default(now())

  @@index([adminUserId, createdAt])
  @@index([module, action, createdAt])
  @@index([resourceId])
}

model Customer {
  id          String         @id @default(cuid())
  openId      String         @unique
  unionId     String?
  nickname    String?
  avatarUrl   String?
  phone       String?
  points      Int            @default(0)
  walletBalance Decimal      @default(0) @db.Decimal(10, 2)
  status      CustomerStatus @default(ENABLED)
  cartItems   CartItem[]
  orders      Order[]
  coupons     CustomerCoupon[]
  addresses   CustomerAddress[]
  favorites   FavoriteProduct[]
  browsingHistories BrowsingHistory[]
  afterSales  AfterSale[]
  reviews     ProductReview[]
  notifications Notification[]
  pointsLedgers PointsLedger[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model Community {
  id           String        @id @default(cuid())
  name         String
  address      String
  enabled      Boolean       @default(true)
  deletedAt    DateTime?
  pickupPoints PickupPoint[]
  orders       Order[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([deletedAt])
}

model PickupPoint {
  id              String    @id @default(cuid())
  communityId     String
  name            String
  address         String
  contactName     String
  contactPhone    String
  pickupTimeRange String
  leaderName      String?
  leaderAvatarUrl String?
  servicePhone    String?
  serviceTimeRange String?
  enabled         Boolean   @default(true)
  deletedAt       DateTime?
  community       Community @relation(fields: [communityId], references: [id])
  orders          Order[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([communityId])
  @@index([deletedAt])
}

model Category {
  id        String     @id @default(cuid())
  name      String
  parentId  String?
  level     Int
  iconUrl   String?
  sort      Int        @default(0)
  enabled   Boolean    @default(true)
  deletedAt DateTime?
  parent    Category?  @relation("CategoryChildren", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryChildren")
  products  Product[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([parentId])
  @@index([enabled, sort])
  @@index([deletedAt])
}

model Product {
  id          String    @id @default(cuid())
  categoryId  String
  name        String
  subtitle    String?
  imageUrl    String
  description String?
  sales       Int       @default(0)
  badge       String?
  enabled     Boolean   @default(true)
  deletedAt   DateTime?
  sort        Int       @default(0)
  category    Category  @relation(fields: [categoryId], references: [id])
  skus        Sku[]
  promotionProducts PromotionProduct[]
  favorites   FavoriteProduct[]
  browsingHistories BrowsingHistory[]
  reviews     ProductReview[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([categoryId])
  @@index([enabled, sort])
  @@index([deletedAt])
}

model Sku {
  id          String      @id @default(cuid())
  productId   String
  name        String
  unit        String
  price       Decimal     @db.Decimal(10, 2)
  marketPrice Decimal?    @db.Decimal(10, 2)
  stock       Int         @default(0)
  lockedStock Int         @default(0)
  enabled     Boolean     @default(true)
  deletedAt   DateTime?
  product     Product     @relation(fields: [productId], references: [id])
  cartItems   CartItem[]
  orderItems  OrderItem[]
  promotionProducts PromotionProduct[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([productId])
  @@index([deletedAt])
}

model CartItem {
  id         String   @id @default(cuid())
  customerId String
  skuId      String
  quantity   Int
  selected   Boolean  @default(true)
  customer   Customer @relation(fields: [customerId], references: [id])
  sku        Sku      @relation(fields: [skuId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([customerId, skuId])
  @@index([customerId])
}

model Order {
  id             String       @id @default(cuid())
  orderNo        String       @unique
  customerId     String
  communityId    String
  pickupPointId  String
  status         OrderStatus  @default(PENDING_PAYMENT)
  pickupCode     String?
  totalAmount    Decimal      @db.Decimal(10, 2)
  discountAmount Decimal      @default(0) @db.Decimal(10, 2)
  payableAmount  Decimal      @db.Decimal(10, 2)
  paidAt         DateTime?
  cancelledAt    DateTime?
  completedAt    DateTime?
  customer       Customer     @relation(fields: [customerId], references: [id])
  community      Community    @relation(fields: [communityId], references: [id])
  pickupPoint    PickupPoint  @relation(fields: [pickupPointId], references: [id])
  items          OrderItem[]
  payments       Payment[]
  afterSales     AfterSale[]
  reviews        ProductReview[]
  customerCoupons CustomerCoupon[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([customerId, status])
  @@index([communityId])
  @@index([pickupPointId])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  skuId       String
  productName String
  skuName     String
  imageUrl    String
  unit        String
  price       Decimal  @db.Decimal(10, 2)
  quantity    Int
  order       Order    @relation(fields: [orderId], references: [id])
  sku         Sku      @relation(fields: [skuId], references: [id])
  afterSaleItems AfterSaleItem[]
  review      ProductReview?

  @@index([orderId])
  @@index([skuId])
}

model Payment {
  id            String        @id @default(cuid())
  orderId       String
  paymentNo     String        @unique
  provider      String        @default("wechat")
  providerTxnId String?
  status        PaymentStatus @default(PENDING)
  amount        Decimal       @db.Decimal(10, 2)
  rawPayload    Json?
  paidAt        DateTime?
  order         Order         @relation(fields: [orderId], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([orderId])
  @@index([status])
}

model UploadAsset {
  id           String       @id @default(cuid())
  storage      AssetStorage @default(LOCAL)
  filename     String
  originalName String
  mimeType     String
  size         Int
  url          String
  path         String
  createdAt    DateTime     @default(now())
}

model HomeBanner {
  id        String      @id @default(cuid())
  scene     BannerScene @default(HOME_TOP)
  title     String
  subtitle  String?
  imageUrl  String
  linkType  String?
  linkValue String?
  sort      Int         @default(0)
  enabled   Boolean     @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([scene, enabled, sort])
}

model PromotionCampaign {
  id        String             @id @default(cuid())
  type      PromotionType
  title     String
  subtitle  String?
  badge     String?
  startsAt  DateTime?
  endsAt    DateTime?
  enabled   Boolean            @default(true)
  sort      Int                @default(0)
  products  PromotionProduct[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([type, enabled, sort])
}

model PromotionProduct {
  id          String            @id @default(cuid())
  campaignId  String
  productId   String
  skuId       String?
  promoPrice  Decimal?          @db.Decimal(10, 2)
  discountLabel String?
  sort        Int               @default(0)
  campaign    PromotionCampaign @relation(fields: [campaignId], references: [id])
  product     Product           @relation(fields: [productId], references: [id])
  sku         Sku?              @relation(fields: [skuId], references: [id])

  @@unique([campaignId, productId, skuId])
  @@index([campaignId, sort])
}

model CouponTemplate {
  id             String           @id @default(cuid())
  type           CouponType        @default(FULL_REDUCTION)
  title          String
  description    String?
  thresholdAmount Decimal          @default(0) @db.Decimal(10, 2)
  discountAmount Decimal          @db.Decimal(10, 2)
  totalStock     Int?
  receivedCount  Int              @default(0)
  usedCount      Int              @default(0)
  startsAt       DateTime?
  endsAt         DateTime?
  enabled        Boolean          @default(true)
  deletedAt      DateTime?
  customerCoupons CustomerCoupon[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([enabled, startsAt, endsAt])
  @@index([deletedAt])
}

model CustomerCoupon {
  id         String               @id @default(cuid())
  customerId String
  templateId String
  status     CustomerCouponStatus @default(AVAILABLE)
  receivedAt DateTime             @default(now())
  usedAt     DateTime?
  orderId    String?
  customer   Customer             @relation(fields: [customerId], references: [id])
  template   CouponTemplate       @relation(fields: [templateId], references: [id])
  order      Order?               @relation(fields: [orderId], references: [id])

  @@index([customerId, status])
  @@index([templateId])
  @@index([orderId])
}

model CustomerAddress {
  id            String   @id @default(cuid())
  customerId    String
  contactName   String
  contactPhone  String
  province      String?
  city          String?
  district      String?
  detailAddress String
  isDefault     Boolean  @default(false)
  customer      Customer @relation(fields: [customerId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([customerId, isDefault])
}

model FavoriteProduct {
  id         String   @id @default(cuid())
  customerId String
  productId  String
  customer   Customer @relation(fields: [customerId], references: [id])
  product    Product  @relation(fields: [productId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
  @@index([customerId])
}

model BrowsingHistory {
  id         String   @id @default(cuid())
  customerId String
  productId  String
  customer   Customer @relation(fields: [customerId], references: [id])
  product    Product  @relation(fields: [productId], references: [id])
  createdAt  DateTime @default(now())

  @@index([customerId, createdAt])
}

model AfterSale {
  id            String          @id @default(cuid())
  afterSaleNo   String          @unique
  customerId    String
  orderId       String
  type          AfterSaleType
  status        AfterSaleStatus @default(PENDING)
  reason        String
  description   String?
  refundAmount  Decimal         @db.Decimal(10, 2)
  rejectReason  String?
  reviewedAt    DateTime?
  refundedAt    DateTime?
  cancelledAt   DateTime?
  customer      Customer        @relation(fields: [customerId], references: [id])
  order         Order           @relation(fields: [orderId], references: [id])
  items         AfterSaleItem[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([customerId, status])
  @@index([orderId])
}

model AfterSaleItem {
  id            String    @id @default(cuid())
  afterSaleId   String
  orderItemId   String
  quantity      Int
  refundAmount  Decimal   @db.Decimal(10, 2)
  afterSale     AfterSale @relation(fields: [afterSaleId], references: [id])
  orderItem     OrderItem @relation(fields: [orderItemId], references: [id])

  @@index([afterSaleId])
  @@index([orderItemId])
}

model ProductReview {
  id          String    @id @default(cuid())
  customerId  String
  orderId     String
  orderItemId String    @unique
  productId   String
  skuId       String
  rating      Int
  content     String?
  imageUrls   String[]
  anonymous   Boolean   @default(false)
  customer    Customer  @relation(fields: [customerId], references: [id])
  order       Order     @relation(fields: [orderId], references: [id])
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  product     Product   @relation(fields: [productId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([customerId])
  @@index([productId, createdAt])
}

model Notification {
  id         String           @id @default(cuid())
  customerId String
  type       NotificationType
  title      String
  content    String
  payload    Json?
  readAt     DateTime?
  customer   Customer         @relation(fields: [customerId], references: [id])
  createdAt  DateTime         @default(now())

  @@index([customerId, readAt])
  @@index([customerId, createdAt])
}

model PointsLedger {
  id          String           @id @default(cuid())
  customerId  String
  type        PointsChangeType
  points      Int
  balance     Int
  description String
  orderId     String?
  customer    Customer         @relation(fields: [customerId], references: [id])
  createdAt   DateTime         @default(now())

  @@index([customerId, createdAt])
}
